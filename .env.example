# ---------------------------------------------------------------------------
# All variables below are OPTIONAL. The site builds and runs without any .env
# file at all. Copy this file to `.env.local` only if you need one of these.
# ---------------------------------------------------------------------------

# Canonical site URL. Used for SEO metadata, Open Graph, sitemap and robots.txt.
# Set this in Vercel → Project → Settings → Environment Variables after deploy.
NEXT_PUBLIC_SITE_URL=https://atikur-rahman.vercel.app

# Optional GitHub token (server-side only, NEVER prefixed with NEXT_PUBLIC_).
# The GitHub section works fine without it using the public, unauthenticated API
# (60 requests/hour/IP). Add a fine-grained token with *read-only public* access
# if you hit rate limits on a busy deployment.
# GITHUB_TOKEN=
